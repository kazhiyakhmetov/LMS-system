# PostgreSQL
POSTGRES_DB=EducationSystem
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password

# Spring local run (outside Docker)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/EducationSystem
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local-db-password

# Backend JWT
# Must be at least 32 bytes for HS256.
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=43200000
